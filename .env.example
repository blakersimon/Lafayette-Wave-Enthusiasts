# ==============================================================================
# Louisiana Surf Finder - Environment Variables Template
# ==============================================================================

# Server Runtime Settings
ENVIRONMENT=production
PORT=8000
HOST=0.0.0.0
ALLOWED_ORIGINS=*
LOG_LEVEL=INFO

# Caching & Background Refresh Intervals (seconds)
CACHE_TTL_BUOYS=600
CACHE_TTL_COOPS=360
CACHE_TTL_FORECASTS=1800
REFRESH_INTERVAL_SECONDS=600

# HTTP Ingestion Client Settings
REQUEST_TIMEOUT_SECONDS=5.0
USER_AGENT=LouisianaSurfFinder/1.0 (Gulf Coast Marine Intelligence; contact@blake-simon.com)

# Optional External Cache (leave empty for default thread/async-safe in-memory cache)
REDIS_URL=

# Porkbun DNS Automation (Used by scripts/setup_porkbun_dns.py)
PORKBUN_DOMAIN=blake-simon.com
PORKBUN_SUBDOMAIN=louisiana-surf
PORKBUN_API_KEY=
PORKBUN_SECRET_KEY=
